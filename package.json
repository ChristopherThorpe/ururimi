{
  "name": "ururimi",
  "private": true,
  "version": "0.0.0",
  "description": "An immersion language-learning framework. First language pack: Kirundi.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm packs:build && pnpm --filter @ururimi/web dev",
    "build": "pnpm packs:build && pnpm --filter @ururimi/web build",
    "preview": "pnpm --filter @ururimi/web preview",
    "packs:build": "tsx tools/build-packs.ts",
    "content:check": "tsx tools/check-content.ts",
    "typecheck": "tsc -p packages/content-schema && tsc -p packages/engine && tsc -p apps/web && tsc -p tools",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "pnpm --filter @ururimi/web e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm content:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@ururimi/content-schema": "workspace:*",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
